      "min_chars": 400
    },
    {
      "id": "complex-03",
      "category": "complex",
      "query": "公司团建20人，从深圳去惠州2天，预算人均800，要能开会和烧烤",
      "expect_any": ["惠州", "团建", "预算"],
      "min_chars": 400
    },
    {
      "id": "complex-04",
      "category": "complex",
      "query": "对海鲜过敏，从厦门去汕头3天，预算2500，行程要避开海鲜餐厅",
      "expect_any": ["汕头", "过敏", "预算"],
      "min_chars": 400
    },
    {
      "id": "complex-05",
      "category": "complex",
      "query": "12月底从北京去哈尔滨4天，预算6000，想看冰雪大世界但怕太冷",
      "expect_any": ["哈尔滨", "冰雪", "预算"],
      "min_chars": 400
    }
  ]
}
